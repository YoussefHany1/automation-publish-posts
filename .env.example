# Copy this file to .env and fill in the values:
#   cp .env.example .env

# ─── AI Providers ────────────────────────────
# Primary provider: gemini | groq
AI_PROVIDER=gemini

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ─── Facebook Graph API (Arabic posts) ───────
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# Optional toggle (default: enabled when credentials are present)
# ENABLE_FACEBOOK=true

# ─── Instagram Graph API (English posts) ─────
# Uses Cloudinary-hosted branded image URL (Option B). Instagram requires a public HTTPS image_url.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Optional toggle (default: enabled when IG + Cloudinary credentials are present)
# ENABLE_INSTAGRAM=true

# ─── Cloudinary (required for Instagram image hosting) ─────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder/tag for deterministic uploads and cleanup
CLOUDINARY_FOLDER=gaming-bot
# CLOUDINARY_TAG=gaming-bot

# ─── Scraper ─────────────────────────────────
TARGET_URL=https://insider-gaming.com/category/news/feed/
# Number of articles checked per cycle
MAX_ARTICLES=10

# ─── Bot Behavior ────────────────────────────
# Repeat interval in minutes (default 15)
CRON_INTERVAL_MINUTES=15
# Max distinct articles that achieve >=1 successful platform publish per cycle (remaining deferred)
MAX_POSTS_PER_CYCLE=2
# Per-platform failed publish attempts before giving up on that platform for an article
MAX_PUBLISH_ATTEMPTS=3
# Delay between publish actions in milliseconds
POST_DELAY_MS=5000
LOG_LEVEL=info
