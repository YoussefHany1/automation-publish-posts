# ════════════════════════════════════════════
#  🔑  Gaming News Bot — Environment Variables
# ════════════════════════════════════════════
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# ─── AI Providers ────────────────────────────
# Primary provider: gemini | groq
AI_PROVIDER=gemini

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (fallback) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Facebook Graph API ──────────────────────
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# ─── Instagram Graph API ─────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ─── Scraper ─────────────────────────────────
TARGET_URL=https://insider-gaming.com/category/news/feed/
# Number of articles checked per cycle
MAX_ARTICLES=10

# ─── Bot Behavior ────────────────────────────
# Repeat interval in minutes (default 15)
CRON_INTERVAL_MINUTES=15
# Max successful posts per cycle (remaining are deferred)
MAX_POSTS_PER_CYCLE=2
# After this many failed publish attempts the article is skipped permanently
MAX_PUBLISH_ATTEMPTS=3
# Delay between posts within a cycle (milliseconds)
POST_DELAY_MS=5000
LOG_LEVEL=info
